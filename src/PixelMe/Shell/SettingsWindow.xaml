<Window x:Class="PixelMe.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="PixelMe"
        Icon="/Assets/PixelMe.ico"
        Width="600"
        Height="720"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="44" Height="44" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PixelMe" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="AppearancePanel" />
            </Border>

            <TextBlock x:Name="BehaviorHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="BehaviorPanel" />
            </Border>

            <TextBlock x:Name="FeaturesHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="FeaturesPanel" />
            </Border>

            <TextBlock x:Name="StreamHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="StreamPanel" />
            </Border>

            <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="GitHubButton" Margin="0,0,8,0" />
                        <Button x:Name="LogButton" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
