<Window x:Class="PixelMe.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="PixelMe"
        Icon="/Assets/PixelMe.ico"
        Width="560"
        Height="660"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="44" Height="44" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PixelMe" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" />
                    <TextBlock x:Name="StyleLabel" Grid.Row="2" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="StyleBox" Grid.Row="2" Grid.Column="1" />
                </Grid>
            </Border>

            <TextBlock x:Name="BehaviorHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartupBox" />
                    <CheckBox x:Name="FullscreenBox" Margin="0,10,0,0" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="GitHubButton" Margin="0,0,8,0" />
                        <Button x:Name="LogButton" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
