<UserControl x:Class="PixelMe.Modules.Media.MediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:PixelMe.Modules.Media">
    <Grid>
        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="{StaticResource Island.IconFont}"
                       FontSize="26"
                       Foreground="{DynamicResource Island.Secondary}"
                       Text="&#xE8D6;" />
            <TextBlock x:Name="EmptyTitle"
                       Margin="0,10,0,4"
                       HorizontalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="EmptyHint"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Island.Secondary}" />
        </StackPanel>

        <Grid x:Name="PlayerState">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="86" Height="86" Margin="2,0,0,0">
                <Border CornerRadius="20" Background="{DynamicResource Island.Subtle}">
                    <Grid>
                        <TextBlock x:Name="ArtPlaceholder"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Island.IconFont}"
                                   FontSize="28"
                                   Foreground="{DynamicResource Island.Secondary}"
                                   Text="&#xE8D6;" />
                        <Border x:Name="ArtImage" CornerRadius="20" />
                    </Grid>
                </Border>
                <Border x:Name="Badge"
                        Width="34"
                        Height="34"
                        Margin="0,0,-9,-9"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="{DynamicResource Island.Surface}"
                        BorderThickness="4"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Island.IconFont}"
                               FontSize="13"
                               Foreground="#1A1A1A"
                               Text="&#xE8D6;" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1"
                        Margin="24,0,10,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="21"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           Margin="0,2,0,0"
                           FontSize="15.5"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LyricText"
                           Margin="0,5,0,0"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource Island.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="PreviousButton"
                        Content="&#xEB9E;"
                        FontSize="20"
                        Foreground="{DynamicResource Island.Secondary}"
                        Style="{StaticResource Island.MediaButton}" />
                <Button x:Name="PlayPauseButton"
                        Width="58"
                        Height="58"
                        Margin="6,0"
                        FontSize="32"
                        Content="&#xE769;"
                        Style="{StaticResource Island.MediaButton}" />
                <Button x:Name="NextButton"
                        Content="&#xEB9D;"
                        FontSize="20"
                        Foreground="{DynamicResource Island.Secondary}"
                        Style="{StaticResource Island.MediaButton}" />
            </StackPanel>

            <media:WaveProgress x:Name="Progress"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Height="20"
                                Margin="0,14,0,0"
                                Track="{DynamicResource Island.Subtle}"
                                Thumb="{DynamicResource Island.Foreground}" />

            <Grid Grid.Row="2"
                  Grid.ColumnSpan="3"
                  Margin="0,2,0,0">
                <TextBlock x:Name="ElapsedText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Island.MonoFont}"
                           FontSize="14"
                           FontWeight="Bold" />
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="MuteButton"
                            Width="28"
                            Height="28"
                            FontSize="14"
                            Content="&#xE767;"
                            Style="{StaticResource Island.IconButton}" />
                    <Slider x:Name="VolumeSlider"
                            Width="140"
                            Margin="8,0,0,0"
                            Style="{StaticResource Island.Slider}" />
                </StackPanel>
                <TextBlock x:Name="RemainingText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Island.MonoFont}"
                           FontSize="14"
                           FontWeight="Bold" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
