<Window x:Class="PixelMe.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelMe Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource Island.Font}"
        TextElement.Foreground="{DynamicResource Island.Foreground}">
    <Canvas>
        <Canvas x:Name="IslandRoot">
            <Path x:Name="Outline" StrokeThickness="1" />
            <Canvas x:Name="Surface">
                <ContentControl x:Name="CompactHost" Focusable="False" />
                <TextBlock x:Name="StripText"
                           Width="360"
                           FontFamily="{StaticResource Island.MonoFont}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Visibility="Hidden" />
                <Grid x:Name="ExpandedHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,6,0,0"
                                Orientation="Horizontal">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        <Border Width="1"
                                Height="18"
                                Margin="4,0,8,0"
                                Background="{DynamicResource Island.Subtle}" />
                        <Button x:Name="SettingsButton" Style="{StaticResource Island.IconButton}" />
                    </StackPanel>
                    <ContentControl x:Name="ExpandedContent"
                                    Grid.Row="1"
                                    Margin="26,0,26,14"
                                    Focusable="False" />
                </Grid>
            </Canvas>
        </Canvas>
    </Canvas>
</Window>
