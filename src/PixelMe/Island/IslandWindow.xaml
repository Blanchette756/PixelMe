<Window x:Class="PixelMe.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelMe Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource Island.Font}"
        TextElement.Foreground="{DynamicResource Island.Foreground}">
    <Grid>
        <Border x:Name="IslandBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BorderThickness="1">
            <Canvas x:Name="Surface">
                <ContentControl x:Name="CompactHost" Focusable="False" />
                <Grid x:Name="ExpandedHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="18,12,12,0" LastChildFill="True">
                        <Button x:Name="SettingsButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Island.IconButton}" />
                        <Grid>
                            <TextBlock x:Name="HeaderTitle"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Island.Secondary}" />
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </Grid>
                    </DockPanel>
                    <ContentControl x:Name="ExpandedContent"
                                    Grid.Row="1"
                                    Margin="18,4,18,16"
                                    Focusable="False" />
                </Grid>
            </Canvas>
        </Border>
    </Grid>
</Window>
